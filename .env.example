# =============================================================
# DRA. PRISCILA — AGENDAMENTO
# Copie para .env e preencha os valores reais.
# N8N_API_SECRET, SESSION_SECRET e MAGIC_LINK_HASH_SECRET
# devem ser diferentes e rotacionáveis.
# =============================================================

# URL base pública do site (usada na composição dos magic links)
APP_BASE_URL=http://localhost:3000

# Segredo de autenticação do n8n (Bearer). Use valor longo e aleatório.
N8N_API_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Segredo para HMAC do hash de token (NÃO use o mesmo valor de N8N_API_SECRET).
MAGIC_LINK_HASH_SECRET=troque-por-outro-segredo-longo

# Segredo para assinar cookies de sessão iron-session.
SESSION_SECRET=troque-por-mais-um-segredo-longo-com-pelo-menos-32-chars

# String de conexão do Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/dra_priscila

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS={"type":"service_account",...}
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo

# Regras de atendimento (JSON opcional)
# Ex.: {"weekdays":{"mon":["08:00-12:00","14:00-18:00"],...},"slot_minutes":15,"window_days":7}
SCHEDULING_RULES_JSON=

# Validade do magic link em minutos.
MAGIC_LINK_TTL_MINUTES=30

# Plano padrão de fallback se o cliente não enviar service_id
DEFAULT_SERVICE_ID=consulta-inicial

# Limite por IP para o endpoint público /a/[token] (req/min)
RATE_LIMIT_PUBLIC_PER_MINUTE=20

# Limite por credencial n8n para /api/v1/magic-links (req/min)
RATE_LIMIT_N8N_PER_MINUTE=120

# Ambiente: development | production
NODE_ENV=development

# URL do webhook de notificações no n8n (cancelamento, remarcação).
# Vazio = notificações desabilitadas — o notifier apenas loga sem chamar ninguém.
WEBHOOK_NOTIFICATIONS_URL=

# URL do webhook de confirmações no n8n (APPOINTMENT_CONFIRMED).
# Workflow distinto do de cancelamento: manda a mensagem de boas-vindas.
WEBHOOK_CONFIRMATION_URL=

# URL do webhook n8n que recebe o POST do backend com a lista de lembretes
# a enviar às 20h (America/Sao_Paulo). Vazio = lembretes desabilitados.
N8N_REMINDER_WEBHOOK_URL=

# Chave compartilhada com o n8n para autenticar o webhook inbound da
# Evolution API. Mínimo 8 caracteres quando setado. Vazio desabilita o
# endpoint /api/v1/webhooks/evolution/inbound (responde 401).
EVOLUTION_INBOUND_SECRET=

# =============================================================
# APENAS PARA docker-compose — NÃO são lidas pelo Next.js direto.
# O compose usa pra provisionar o Postgres e preencher DATABASE_URL
# automaticamente. Em Dokploy, defina POSTGRES_PASSWORD no painel.
# =============================================================
POSTGRES_USER=dra
POSTGRES_PASSWORD=
POSTGRES_DB=dra_priscila
