// Prisma schema — DRA. PRISCILA agendamento
// Modelo de dados inicial descrito no PRD seção 7.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id            String   @id @default(cuid())
  phoneE164     String   @unique @map("phone_e164")
  name          String?
  healthPlan    String?  @map("health_plan")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  magicLinks    MagicLink[]
  appointments  Appointment[]

  @@index([phoneE164])
  @@map("patients")
}

model MagicLink {
  id              String    @id @default(cuid())
  patientId       String    @map("patient_id")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  firstOpenedAt   DateTime? @map("first_opened_at")
  consumedAt      DateTime? @map("consumed_at")
  revokedAt       DateTime? @map("revoked_at")
  source          String?
  conversationId  String?   @map("conversation_id")
  serviceId       String?   @map("service_id")
  // Rota interna para onde o paciente vai após abrir o link.
  // Default em runtime: /agendar (compat com links antigos sem essa coluna).
  redirectTo      String?   @map("redirect_to")
  createdAt       DateTime  @default(now()) @map("created_at")

  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointments    Appointment[]
  idempotencyKeys IdempotencyKey[]

  @@index([patientId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("magic_links")
}

model Service {
  id               String   @id
  name             String
  durationMinutes  Int      @default(15) @map("duration_minutes")
  active           Boolean  @default(true)
  // regras livres em JSON: por ex. restrição de plano, antecedência etc.
  schedulingRules  Json?    @map("scheduling_rules")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  appointments     Appointment[]

  @@map("services")
}

model Appointment {
  id                        String   @id @default(cuid())
  patientId                 String   @map("patient_id")
  magicLinkId               String?  @map("magic_link_id")
  serviceId                 String   @map("service_id")
  startsAt                  DateTime @map("starts_at")
  endsAt                    DateTime @map("ends_at")
  status                    AppointmentStatus @default(CONFIRMED)
  externalCalendarEventId   String?  @map("external_calendar_event_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  magicLink   MagicLink? @relation(fields: [magicLinkId], references: [id])
  service     Service    @relation(fields: [serviceId], references: [id])
  confirmations AppointmentConfirmation[]

  // Garante que não existam dois appointments ativos na mesma janela.
  // (Paciente + serviço + horário) é a chave prática; appointment_event unique
  // protege contra colisão externa duplicada quando o ID do evento chega.
  @@unique([startsAt, serviceId], name: "appointment_starts_service_unique")
  @@index([patientId])
  @@index([startsAt])
  @@map("appointments")
}

// Lembrete proativo de confirmação enviado por WhatsApp às 20h para
// consultas nas próximas 12–24h. sentDay é a chave de idempotência
// (um lembrete por consulta por dia) e evolutionMessageId protege
// contra reentrega do webhook pela Evolution API.
model AppointmentConfirmation {
  id                 String    @id @default(cuid())
  appointmentId      String    @map("appointment_id")
  sentDay            DateTime  @map("sent_day")
  sentAt             DateTime  @default(now()) @map("sent_at")
  respondedAt        DateTime? @map("responded_at")
  responseType       String?   @map("response_type")
  rawResponse        String?   @map("raw_response")
  evolutionMessageId String?   @unique @map("evolution_message_id")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, sentDay], name: "appointment_confirmation_unique_per_day")
  @@index([appointmentId])
  @@index([sentDay])
  @@index([respondedAt])
  @@map("appointment_confirmations")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

model AuditEvent {
  id            String   @id @default(cuid())
  eventType     String   @map("event_type")
  patientId     String?  @map("patient_id")
  magicLinkId   String?  @map("magic_link_id")
  metadataJson  Json?    @map("metadata_json")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([patientId])
  @@index([magicLinkId])
  @@map("audit_events")
}

model IdempotencyKey {
  id            String   @id @default(cuid())
  key           String   @unique
  magicLinkId   String?  @map("magic_link_id")
  requestHash   String   @map("request_hash")
  responseJson  Json     @map("response_json")
  createdAt     DateTime @default(now()) @map("created_at")

  magicLink     MagicLink? @relation(fields: [magicLinkId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("idempotency_keys")
}
